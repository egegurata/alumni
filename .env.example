# Alumni Tracking System — Environment Variables Template
# Copy this file to .env before running: cp .env.example .env

PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=alumni_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=alumni_db
DB_HOST=localhost
DB_PORT=5432

# Full Connection String
DATABASE_URL=postgres://alumni_user:change_me_in_local_env@localhost:5432/alumni_db
